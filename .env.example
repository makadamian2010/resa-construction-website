# Keep real credentials in a local .env file or your hosting provider's secret manager.
RESEND_API_KEY=re_your_resend_api_key
# This must be a sender address verified in Resend.
RESEND_FROM_EMAIL=RESA Construction <estimates@your-verified-domain.com>
# Twilio credentials and phone numbers must be stored in Vercel, never in frontend code.
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_FROM_NUMBER=+14085550100
INQUIRY_SMS_TO=6696490932
